# Local PostgreSQL started with: docker compose up -d db
DATABASE_URL=url-to-your-database
ACCESS_TOKEN_EXPIRE=your_time_in_minutes
SECRET_KEY=replace-with-a-random-secret
ALGORITHM=algorithm-used-for-token-signing

# Replace these placeholders with your SMTP provider settings.
MAIL_USERNAME=replace-it-with-your-email
MAIL_PASSWORD=replace-it-with-your-app-password


MAIL_FROM_NAME=noreply@example.com
MAIL_SERVER=smtp.example.com
MAIL_PORT=587

# Duffel sandbox: set your test access token locally; never commit it.
DUFFEL_ACCESS_TOKEN=
DUFFEL_BASE_URL=https://api.duffel.com
